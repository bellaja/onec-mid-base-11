#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//--
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	//--
	
	//++	
	СкидкаСуммарная = Объект.Дораб_СогласованнаяСкидка + ТекущиеДанные.Скидка;
	Если СкидкаСуммарная > 100 Тогда
		СкидкаСуммарная = 100;
	КонецЕсли;
	
	Коэффициент = (100 - СкидкаСуммарная) / 100;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * Коэффициент;
	//++
	
	
КонецПроцедуры

//++ 
&НаКлиенте
Асинх Процедура ПересчитатьТаблицуАсинх()
	
	ЕстьСтроки = (Объект.Товары.Количество() > 0) Или (Объект.Услуги.Количество() > 0);
	
	Если Не ЕстьСтроки Тогда
		Сообщить("Табличные части пусты — пересчитывать нечего.");
		Возврат;
	КонецЕсли;
	
	Вопрос = ВопросАсинх(
	"Пересчитать суммы в табличной части с учётом новой скидки?",
	РежимДиалогаВопрос.ДаНет);
	Ответ = Ждать Вопрос;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПересчитатьСуммыТабличныхЧастейСоСкидкой();
	Иначе 
		Сообщить("Пересчёт отменён");
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры

//++ 
&НаКлиенте
Процедура ПересчитатьСуммыТабличныхЧастейСоСкидкой()
	
	// Товары
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(СтрокаТоваров);
				
	КонецЦикла;
	
	// Услуги 
	Для Каждого СтрокаУслуг Из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(СтрокаУслуг);
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

