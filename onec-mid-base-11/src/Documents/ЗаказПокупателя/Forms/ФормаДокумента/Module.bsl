
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ 
	ГруппаПересчет = Элементы.Добавить("ГруппаКоличество", Тип("ГруппаФормы"), ЭтаФорма.Элементы.ГруппаШапкаЛево);
	ГруппаПересчет.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПересчет.Видимость = Истина;
	ГруппаПересчет.РастягиватьПоГоризонтали = Истина;
	ГруппаПересчет.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда; 
	ГруппаПересчет.ОтображатьЗаголовок = Ложь;
	
	ПолеКонтактноеЛицо = Элементы.Добавить("Дораб_СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаПересчет);
	ПолеКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКонтактноеЛицо.ПутьКДанным = "Объект.Дораб_СогласованнаяСкидка";
	
	ПолеКонтактноеЛицо.УстановитьДействие("ПриИзменении", "Дораб_СогласованнаяСкидкаПриИзменении");
	
	ПолеКонтактноеЛицо = Элементы.Добавить("Дораб_КонтактноеЛицо", Тип("ПолеФормы"), ЭтаФорма.Элементы.ГруппаШапкаПраво);
	ПолеКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКонтактноеЛицо.ПутьКДанным = "Объект.Дораб_КонтактноеЛицо";
	
	КомандаПересчитать = Команды.Добавить("КомандаПересчитать");
	КомандаПересчитать.Заголовок = "Пересчитать";
	КомандаПересчитать.Действие = "КомандаПересчитать"; 	
	
	КнопкаПересчитать = Элементы.Добавить("КнопкаПересчитать", Тип("КнопкаФормы"), ГруппаПересчет);
	КнопкаПересчитать.ИмяКоманды = "КомандаПересчитать";
	КнопкаПересчитать.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаПересчитать.Заголовок = "Пересчитать таблицу";
	КнопкаПересчитать.Картинка = БиблиотекаКартинок.Обновить;
	КнопкаПересчитать.Отображение = ОтображениеКнопки.КартинкаИТекст;
	//++ 
	
КонецПроцедуры

